#! oefening id=L05-BOSS-2 rol=boss fase="Fase 2" moeilijkheid=4 xp=150 titel="Morsedecoder" bron="D09morse"
Schrijf een programma dat de gebruiker telkens om de morsecode voor een letter vraagt en zo gaandeweg een tekstbericht opbouwt. Gebruik de parallelle arrays uit de briefing. Is een code ongeldig (niet gevonden in `morse`), dan wordt ze genegeerd.

In de cursus eindigt het programma nooit. Onze versie stopt wanneer de gebruiker `stop` intypt en toont dan het volledige bericht.

```text
Morse code voor de volgende letter (. voor kort, - voor lang) ?: -...
Opgebouwde tekst tot nu toe : b
Morse code voor de volgende letter (. voor kort, - voor lang) ?: .-
Opgebouwde tekst tot nu toe : ba
Morse code voor de volgende letter (. voor kort, - voor lang) ?: -..--.
Ongeldige morse code!
Opgebouwde tekst tot nu toe : ba
Morse code voor de volgende letter (. voor kort, - voor lang) ?: .-..
Opgebouwde tekst tot nu toe : bal
Morse code voor de volgende letter (. voor kort, - voor lang) ?: stop
Bericht: bal
```

#! starter
using System;

namespace D09 {
    class Program {
        static void Main(string[] args) {
            string[] morse = { ".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---", "-.-", ".-..", "--", "-.", "---", ".--.", "--.-", ".-.", "...", "-", "..-", "...-", ".--", "-..-", "-.--", "--.." };
            char[] letters = { 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z' };

        }
    }
}

#! hint
Herhaal: vraag een code, stop bij "stop", zoek de code anders in `morse`.

#! hint
Zoek de index van de code in `morse` (met `break` bij een treffer). Gevonden → voeg `letters[index]` toe aan het bericht. Niet gevonden → "Ongeldige morse code!".

#! hint
Na elke (geldige of ongeldige) code toon je `Opgebouwde tekst tot nu toe : …`. Na "stop" toon je `Bericht: …`.

#! oplossing
using System;

namespace D09 {
    class Program {
        static void Main(string[] args) {
            string[] morse = { ".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---", "-.-", ".-..", "--", "-.", "---", ".--.", "--.-", ".-.", "...", "-", "..-", "...-", ".--", "-..-", "-.--", "--.." };
            char[] letters = { 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z' };
            string bericht = "";
            bool stoppen = false;
            while (!stoppen) {
                Console.Write("Morse code voor de volgende letter (. voor kort, - voor lang) ?: ");
                string code = Console.ReadLine().Trim();
                if (code.ToLower() == "stop") {
                    stoppen = true;
                } else {
                    int index = -1;
                    for (int i = 0; i < morse.Length; i++) {
                        if (morse[i] == code) {
                            index = i;
                            break;
                        }
                    }
                    if (index == -1) {
                        Console.WriteLine("Ongeldige morse code!");
                    } else {
                        bericht += letters[index];
                    }
                    Console.WriteLine($"Opgebouwde tekst tot nu toe : {bericht}");
                }
            }
            Console.WriteLine($"Bericht: {bericht}");
        }
    }
}

#! uitleg
- De code wordt gezocht in `morse`; de letter komt uit `letters` op **dezelfde index**: de kern van parallelle arrays.
- Ongeldige codes laten `index` op -1 en worden genegeerd.

#! test naam="Voorbeeld uit de cursus"
#! invoer
-...
.-
-..--.
.-..
stop
#! verwacht
