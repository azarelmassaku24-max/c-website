#! hint
Een private `Bankrekening[] _rekeningen` (grootte = capaciteit) en `AantalRekeningen { get; private set; }`. De eerste `AantalRekeningen` elementen zijn gevuld, de rest is null.

#! hint
`Zoek`: loop tot `AantalRekeningen` en vergelijk `_rekeningen[i].Rekeningnummer`. `Openen` gebruikt `Zoek` om dubbels te vermijden.

#! hint
`Overschrijven`: `Bankrekening a = Zoek(van); Bankrekening b = Zoek(naar); if (a == null || b == null || !a.Afhalen(bedrag)) return false; b.Storten(bedrag); return true;`

#! oplossing bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Rekeningkantoor kantoor = new Rekeningkantoor(3);
            kantoor.Openen("BE01", 200M);
            kantoor.Openen("BE02", 150M);
            Console.WriteLine($"{kantoor.AantalRekeningen} rekeningen, totaal {kantoor.GetTotaalSaldo():f2}");
            Console.WriteLine($"Overschrijving gelukt: {kantoor.Overschrijven("BE01", "BE02", 100M)}");
            Console.WriteLine($"BE01: {kantoor.Zoek("BE01").Saldo:f2} | BE02: {kantoor.Zoek("BE02").Saldo:f2}");
            Console.WriteLine($"Dubbel nummer: {kantoor.Openen("BE01", 5M)}");
            Console.WriteLine($"Onbekend: {kantoor.Overschrijven("BE01", "XX", 1M)}");
        }
    }
}

#! oplossing bestand=Bankrekening.cs
namespace D15 {
    class Bankrekening {
        public string Rekeningnummer { get; }
        public decimal Saldo { get; private set; }

        public Bankrekening(string rekeningnummer) : this(rekeningnummer, 0) { }

        public Bankrekening(string rekeningnummer, decimal beginsaldo) {
            Rekeningnummer = rekeningnummer;
            if (beginsaldo > 0) {
                Saldo = beginsaldo;
            }
        }

        public bool Storten(decimal bedrag) {
            if (bedrag > 0) { Saldo += bedrag; return true; }
            return false;
        }

        public bool Afhalen(decimal bedrag) {
            if (bedrag > 0 && bedrag <= Saldo) { Saldo -= bedrag; return true; }
            return false;
        }
    }
}

#! oplossing bestand=Rekeningkantoor.cs
namespace D15 {
    class Rekeningkantoor {
        private Bankrekening[] _rekeningen;

        public int AantalRekeningen { get; private set; }

        public Rekeningkantoor(int capaciteit) {
            _rekeningen = new Bankrekening[capaciteit];
        }

        public bool Openen(string rekeningnummer, decimal beginsaldo) {
            if (AantalRekeningen == _rekeningen.Length || Zoek(rekeningnummer) != null) {
                return false;
            }
            _rekeningen[AantalRekeningen] = new Bankrekening(rekeningnummer, beginsaldo);
            AantalRekeningen++;
            return true;
        }

        public Bankrekening Zoek(string rekeningnummer) {
            for (int i = 0; i < AantalRekeningen; i++) {
                if (_rekeningen[i].Rekeningnummer == rekeningnummer) {
                    return _rekeningen[i];
                }
            }
            return null;
        }

        public decimal GetTotaalSaldo() {
            decimal totaal = 0;
            for (int i = 0; i < AantalRekeningen; i++) {
                totaal += _rekeningen[i].Saldo;
            }
            return totaal;
        }

        public bool Overschrijven(string van, string naar, decimal bedrag) {
            Bankrekening bron = Zoek(van);
            Bankrekening doel = Zoek(naar);
            if (bron == null || doel == null || !bron.Afhalen(bedrag)) {
                return false;
            }
            doel.Storten(bedrag);
            return true;
        }
    }
}

#! uitleg
- Het kantoor *heeft* een array van rekeningen (compositie) en beheert die zelf: de buitenwereld ziet alleen methods en `AantalRekeningen`.
- `Openen` hergebruikt `Zoek` om dubbele nummers te weigeren; `Overschrijven` hergebruikt `Zoek`, `Afhalen` en `Storten`: elke klasse doet zijn eigen taak.
- Kortsluitevaluatie in `bron == null || … || !bron.Afhalen(...)`: Afhalen wordt enkel opgeroepen als bron niet null is, en enkel dan wordt er effectief afgehaald.
- Level 11 is af! In Level 12 vervangt `List<T>` de array en het teller-gedoe.

