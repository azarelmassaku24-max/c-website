#! test naam="Meteen stoppen" referentie=ja
#! invoer
0

#! test naam="IsGeldig" soort=code
Check.Equal(false, Program.IsGeldig(4, 0), "IsGeldig(4, 0): deling door nul");
Check.Equal(true, Program.IsGeldig(4, 2), "IsGeldig(4, 2)");
Check.Equal(true, Program.IsGeldig(1, 0), "IsGeldig(1, 0): optellen met 0 mag");
