#! test naam="Negatief beginsaldo en regels" soort=code
Bankrekening r = new Bankrekening("X", -50M);
Check.Equal(0M, r.Saldo, "negatief beginsaldo wordt 0");
Check.Equal(true, r.Storten(20M), "Storten(20)");
Check.Equal(false, r.Afhalen(30M), "Afhalen(30) bij saldo 20");
Check.Equal(20M, r.Saldo, "saldo ongewijzigd");

#! oefening id=L11-BOSS-2 rol=boss fase="Fase 2" moeilijkheid=5 xp=220 titel="Het kantoor"
Schrijf `Rekeningkantoor` (compositie):

- constructor `Rekeningkantoor(int capaciteit)` — het kantoor kan maximaal zoveel rekeningen bevatten;
- property `AantalRekeningen` (enkel lezen);
- `bool Openen(string rekeningnummer, decimal beginsaldo)` — maakt een rekening aan; `false` als het kantoor vol is of het nummer al bestaat;
- `Bankrekening Zoek(string rekeningnummer)` — of `null`;
- `decimal GetTotaalSaldo()` — som van alle saldi;
- `bool Overschrijven(string van, string naar, decimal bedrag)` — `false` als een rekening niet bestaat of het afhalen mislukt (dan blijft alles ongewijzigd).

```text
2 rekeningen, totaal 350,00
Overschrijving gelukt: True
BE01: 100,00 | BE02: 250,00
Dubbel nummer: False
Onbekend: False
```

#! starter bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Rekeningkantoor kantoor = new Rekeningkantoor(3);
            kantoor.Openen("BE01", 200M);
            kantoor.Openen("BE02", 150M);
            Console.WriteLine($"{kantoor.AantalRekeningen} rekeningen, totaal {kantoor.GetTotaalSaldo():f2}");
            Console.WriteLine($"Overschrijving gelukt: {kantoor.Overschrijven("BE01", "BE02", 100M)}");
            Console.WriteLine($"BE01: {kantoor.Zoek("BE01").Saldo:f2} | BE02: {kantoor.Zoek("BE02").Saldo:f2}");
            Console.WriteLine($"Dubbel nummer: {kantoor.Openen("BE01", 5M)}");
            Console.WriteLine($"Onbekend: {kantoor.Overschrijven("BE01", "XX", 1M)}");
        }
    }
}

