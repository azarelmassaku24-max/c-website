<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CSharpQuest.Server</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- De runtime wordt samen met de code van de leerling gecompileerd, niet met de server. -->
    <Compile Remove="Runtime/**" />
    <EmbeddedResource Include="Runtime/QuestRuntime.cs" LogicalName="QuestRuntime.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpQuest.Tests" />
  </ItemGroup>

</Project>
