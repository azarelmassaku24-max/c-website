#! hint
`public string Rekeningnummer { get; }` en `public decimal Saldo { get; private set; }`.

#! hint
`public Bankrekening(string rekeningnummer) : this(rekeningnummer, 0) { }` en de tweede constructor stelt de waarden in (negatief beginsaldo → 0).

#! hint
Storten en Afhalen zoals in Level 10/11, maar nu met de property `Saldo`.

#! oplossing bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Bankrekening a = new Bankrekening("BE01", 100M);
            Bankrekening b = new Bankrekening("BE02");
            Console.WriteLine($"{a.Rekeningnummer}: {a.Saldo:f2}");
            Console.WriteLine($"{b.Rekeningnummer}: {b.Saldo:f2}");
            if (!b.Afhalen(10M)) {
                Console.WriteLine("Afhalen mislukt.");
