True
True
True
True
True
True

#! test naam="Waarden" soort=code
Artikel a = new Artikel(50M);
Check.Equal(21M, a.BtwPercentage, "standaard btw");
a.BtwPercentage = 12M;
Check.Equal(56M, a.PrijsInclusiefBtw(), "50 + 12%");

#! oefening id=L11-03-m rol=meesterschap moeilijkheid=3 xp=120 titel="Immutable Punt en Cirkel" bron="D15afstandtussenpunten + D15immutablecirkel"
Maak twee **immutable** klassen:

- `Punt` met properties `X` en `Y` (enkel get), een constructor `Punt(double x, double y)` en een static method `GetAfstandTussen(Punt p1, Punt p2)`.
- `Cirkel` met property `Straal` (enkel get), een constructor `Cirkel(double straal)` en methods `Omtrek()` en `Oppervlakte()`. Een negatieve straal in de constructor wordt **0**.

Main toont:

```text
5
31,42
```

(de afstand tussen (4,6) en (7,2), en de omtrek van een cirkel met straal 5).

#! starter bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Punt p1 = new Punt(4, 6);
            Punt p2 = new Punt(7, 2);
            Console.WriteLine(Punt.GetAfstandTussen(p1, p2));
            Cirkel c = new Cirkel(5);
            Console.WriteLine($"{c.Omtrek():f2}");
        }
    }
}

#! starter bestand=Punt.cs
using System;

namespace D15 {
    class Punt {

    }
}

#! starter bestand=Cirkel.cs
using System;

namespace D15 {
    class Cirkel {

    }
}

#! hint
Immutable betekent: properties met enkel `{ get; }` en alle waarden via de constructor.

#! hint
`public double X { get; }` kan je enkel in de constructor instellen: `X = x;`.

#! hint
Cirkel: `Straal = straal >= 0 ? straal : 0;` — of een gewone if.

#! oplossing bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Punt p1 = new Punt(4, 6);
            Punt p2 = new Punt(7, 2);
            Console.WriteLine(Punt.GetAfstandTussen(p1, p2));
            Cirkel c = new Cirkel(5);
            Console.WriteLine($"{c.Omtrek():f2}");
        }
    }
}

#! oplossing bestand=Punt.cs
using System;

namespace D15 {
    class Punt {
        public double X { get; }
        public double Y { get; }

        public Punt(double x, double y) {
            X = x;
            Y = y;
        }

        public static double GetAfstandTussen(Punt p1, Punt p2) {
            double dx = p2.X - p1.X;
            double dy = p2.Y - p1.Y;
            return Math.Sqrt(dx * dx + dy * dy);
        }
    }
}

#! oplossing bestand=Cirkel.cs
using System;

namespace D15 {
    class Cirkel {
        public double Straal { get; }

        public Cirkel(double straal) {
            if (straal >= 0) {
                Straal = straal;
            }
        }

        public double Omtrek() {
            return 2 * Math.PI * Straal;
        }

        public double Oppervlakte() {
            return Math.PI * Straal * Straal;
        }
    }
}

#! uitleg
- Zonder set kan niemand de waarden nog wijzigen; de constructor is de enige plek waar ze ingesteld worden.
- De controle van de straal gebeurt in de constructor: een Cirkel is dus vanaf zijn geboorte geldig en blijft dat.

#! regel type=readonly-property doel=Punt.X bericht="X is enkel uitleesbaar (geen set)"
#! regel type=readonly-property doel=Cirkel.Straal bericht="Straal is enkel uitleesbaar (geen set)"
#! regel type=constructor doel=Punt parameters=2 bericht="Maak een constructor Punt(double x, double y)"

#! test naam="Uitvoer"
#! verwacht
5
31,42

#! test naam="Negatieve straal wordt 0" soort=code
Cirkel c = new Cirkel(-3);
Check.Equal(0.0, c.Straal, "negatieve straal");
Check.Equal(0.0, c.Oppervlakte(), "oppervlakte 0");
Check.Equal(2.0, new Punt(1, 2).Y, "Y van (1, 2)");
