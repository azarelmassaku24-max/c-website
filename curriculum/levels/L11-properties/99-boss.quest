#! regel type=readonly-property doel=Rekeningkantoor.AantalRekeningen bericht="AantalRekeningen is enkel uitleesbaar van buiten"
#! regel type=private-fields bericht="Datavelden zijn private"
#! regel type=method doel=Overschrijven geeft=bool parameters=3 bericht="Maak een method public bool Overschrijven(string van, string naar, decimal bedrag)"

#! test naam="Main"
#! verwacht
2 rekeningen, totaal 350,00
Overschrijving gelukt: True
BE01: 100,00 | BE02: 250,00
Dubbel nummer: False
Onbekend: False

#! test naam="Capaciteit en mislukte overschrijving" soort=code
Rekeningkantoor k = new Rekeningkantoor(1);
Check.Equal(true, k.Openen("A", 10M), "eerste rekening");
Check.Equal(false, k.Openen("B", 10M), "kantoor is vol");
Check.Equal(1, k.AantalRekeningen, "AantalRekeningen");
Check.Equal(false, k.Overschrijven("A", "B", 5M), "naar onbekende rekening");
Check.Equal(10M, k.Zoek("A").Saldo, "saldo A ongewijzigd");
Check.True(k.Zoek("B") == null, "B bestaat niet");
