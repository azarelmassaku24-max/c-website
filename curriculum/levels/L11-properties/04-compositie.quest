#! oefening id=L11-04-m rol=meesterschap moeilijkheid=4 xp=130 titel="Overlappende cirkels" bron="D15cirkeloverlapt"
Voeg aan `Cirkel` een **static** method `Overlapt(Cirkel c1, Cirkel c2)` toe. Twee cirkels overlappen als de afstand tussen hun middelpunten **kleiner is dan de som van hun stralen**.

Kijk in de testcode of `Overlapt` een instance- of class method moet zijn.

```text
True
False
```

#! starter bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Cirkel c1 = new Cirkel(10, 20, 5);
            Cirkel c2 = new Cirkel(8, 12, 10);
            Cirkel c3 = new Cirkel(100, 200, 3);
            Console.WriteLine(Cirkel.Overlapt(c1, c2));
            Console.WriteLine(Cirkel.Overlapt(c2, c3));
        }
    }
}

#! starter bestand=Punt.cs
using System;

namespace D15 {
    class Punt {
        public double X { get; }
        public double Y { get; }

        public Punt(double x, double y) {
            X = x;
            Y = y;
        }

        public static double GetAfstandTussen(Punt p1, Punt p2) {
            double dx = p2.X - p1.X;
            double dy = p2.Y - p1.Y;
            return Math.Sqrt(dx * dx + dy * dy);
        }
    }
}

#! starter bestand=Cirkel.cs
using System;

namespace D15 {
    class Cirkel {
        public Punt Middelpunt { get; private set; }
        public double Straal { get; }

        public Cirkel(double x, double y, double straal) {
            Middelpunt = new Punt(x, y);
            Straal = straal;
        }
    }
}

#! hint
De aanroep is `Cirkel.Overlapt(c1, c2)` — via de klassenaam, dus `static`.

#! hint
`public static bool Overlapt(Cirkel c1, Cirkel c2)` — gebruik `Punt.GetAfstandTussen(c1.Middelpunt, c2.Middelpunt)`.

#! hint
`return afstand < c1.Straal + c2.Straal;`

#! oplossing bestand=Program.cs
using System;

namespace D15 {
    class Program {
        static void Main() {
            Cirkel c1 = new Cirkel(10, 20, 5);
            Cirkel c2 = new Cirkel(8, 12, 10);
            Cirkel c3 = new Cirkel(100, 200, 3);
            Console.WriteLine(Cirkel.Overlapt(c1, c2));
            Console.WriteLine(Cirkel.Overlapt(c2, c3));
        }
    }
}

#! oplossing bestand=Punt.cs
using System;

namespace D15 {
    class Punt {
        public double X { get; }
        public double Y { get; }

        public Punt(double x, double y) {
            X = x;
            Y = y;
        }

        public static double GetAfstandTussen(Punt p1, Punt p2) {
            double dx = p2.X - p1.X;
            double dy = p2.Y - p1.Y;
            return Math.Sqrt(dx * dx + dy * dy);
        }
    }
}

#! oplossing bestand=Cirkel.cs
using System;

namespace D15 {
    class Cirkel {
        public Punt Middelpunt { get; private set; }
        public double Straal { get; }

        public Cirkel(double x, double y, double straal) {
            Middelpunt = new Punt(x, y);
            Straal = straal;
        }

        public static bool Overlapt(Cirkel c1, Cirkel c2) {
            double afstand = Punt.GetAfstandTussen(c1.Middelpunt, c2.Middelpunt);
            return afstand < c1.Straal + c2.Straal;
        }
    }
}

#! uitleg
- De vergelijking gaat over **twee** cirkels zonder dat een van beide "de hoofdrol" speelt: een static method is hier natuurlijk. (Een instance-variant `c1.Overlapt(c2)` zou ook kunnen.)
- Ze hergebruikt `Punt.GetAfstandTussen` via de middelpunten: twee klassen die samenwerken.

#! regel type=regex doel="public\s+static\s+bool\s+Overlapt\s*\(\s*Cirkel" bericht="Maak een public static bool Overlapt(Cirkel c1, Cirkel c2)"

#! test naam="Main" mode=exact
#! verwacht
True
False

#! test naam="Randgeval: raken" soort=code
Cirkel a = new Cirkel(0, 0, 3);
Cirkel b = new Cirkel(7, 0, 4);
Check.Equal(false, Cirkel.Overlapt(a, b), "raken precies (afstand = som van stralen)");
Check.Equal(true, Cirkel.Overlapt(a, new Cirkel(6, 0, 4)), "overlappen net wel");
