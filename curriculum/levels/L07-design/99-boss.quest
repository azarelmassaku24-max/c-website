#! test naam="GetRichting vertaalt toetsen" soort=code
Check.Equal("Boven", Program.GetRichting(ConsoleKey.W).ToString(), "W");
Check.Equal("Links", Program.GetRichting(ConsoleKey.LeftArrow).ToString(), "pijltje links");
Check.Equal("Rechts", Program.GetRichting(ConsoleKey.D).ToString(), "D");
Check.Equal("Geen", Program.GetRichting(ConsoleKey.X).ToString(), "X");

#! oefening id=L07-BOSS-2 rol=boss fase="Fase 2" moeilijkheid=5 xp=200 titel="Het doolhof" interactief=ja
Nu wordt het een echt doolhof. Het plan staat in een `string[]`:

```csharp norun
string[] plan = {
    "##########",
    "#@   #   #",
    "# ## # # #",
    "#  #   #G#",
    "##########"
};
```

- De `@` geeft de startpositie aan (teken daar later een spatie, de speler wordt apart getekend).
- De speler kan **niet** door `#` lopen (de zet telt dan niet).
- Bereikt de speler `G`, dan stopt het spel: cursor op (0, 6) en `Gewonnen in 13 zetten!`.
- Bij **Q**: cursor op (0, 6) en `Opgegeven na 3 zetten.`

Maak een method `static bool IsVrij(string[] plan, int x, int y)` die zegt of een positie geen muur is (let op: `plan[y][x]`).

#! starter
using System;

namespace D11 {
    class Program {
        enum Richting { Boven, Onder, Links, Rechts, Geen };

        static void Main(string[] args) {
            string[] plan = {
                "##########",
                "#@   #   #",
                "# ## # # #",
                "#  #   #G#",
                "##########"
            };
            Console.CursorVisible = false;

        }
    }
}

#! hint
Zoek eerst de startpositie: overloop de rijen en gebruik `plan[y].IndexOf('@')`. Teken het plan met `Replace('@', ' ')`.

#! hint
Bereken bij elke toets de nieuwe positie (`nieuwX`, `nieuwY`) en verplaats enkel als `IsVrij(plan, nieuwX, nieuwY)`. `plan[y][x]` is het karakter in rij y, kolom x.

#! hint
Na een geslaagde zet: `if (plan[y][x] == 'G')` → gewonnen. Gebruik een `bool gedaan` voor de spelloop en onthoud of het gewonnen of opgegeven was.

#! oplossing
using System;

namespace D11 {
    class Program {
        enum Richting { Boven, Onder, Links, Rechts, Geen };

        static void Main(string[] args) {
            string[] plan = {
                "##########",
                "#@   #   #",
                "# ## # # #",
                "#  #   #G#",
                "##########"
            };
            Console.CursorVisible = false;
            int x = 0;
            int y = 0;
            for (int rij = 0; rij < plan.Length; rij++) {
                int kolom = plan[rij].IndexOf('@');
                if (kolom != -1) {
                    x = kolom;
                    y = rij;
                }
            }

            int zetten = 0;
            bool gedaan = false;
            bool gewonnen = false;
            Teken(plan, x, y);
            while (!gedaan) {
                ConsoleKeyInfo info = Console.ReadKey(true);
                if (info.Key == ConsoleKey.Q) {
                    gedaan = true;
                } else {
                    Richting richting = GetRichting(info.Key);
                    int nieuwX = x;
                    int nieuwY = y;
                    if (richting == Richting.Boven) nieuwY--;
                    else if (richting == Richting.Onder) nieuwY++;
                    else if (richting == Richting.Links) nieuwX--;
                    else if (richting == Richting.Rechts) nieuwX++;
                    if (richting != Richting.Geen && IsVrij(plan, nieuwX, nieuwY)) {
                        x = nieuwX;
                        y = nieuwY;
                        zetten++;
                        if (plan[y][x] == 'G') {
                            gedaan = true;
                            gewonnen = true;
                        }
                    }
                    Teken(plan, x, y);
                }
            }
            Console.SetCursorPosition(0, plan.Length + 1);
            if (gewonnen) {
                Console.WriteLine($"Gewonnen in {zetten} zetten!");
            } else {
                Console.WriteLine($"Opgegeven na {zetten} zetten.");
            }
        }

        static bool IsVrij(string[] plan, int x, int y) {
            return plan[y][x] != '#';
        }

        static void Teken(string[] plan, int x, int y) {
            Console.Clear();
            for (int rij = 0; rij < plan.Length; rij++) {
                Console.SetCursorPosition(0, rij);
                Console.Write(plan[rij].Replace('@', ' '));
            }
            Console.SetCursorPosition(x, y);
            Console.Write("@");
        }

        static Richting GetRichting(ConsoleKey toets) {
            if (toets == ConsoleKey.W || toets == ConsoleKey.UpArrow) return Richting.Boven;
            if (toets == ConsoleKey.S || toets == ConsoleKey.DownArrow) return Richting.Onder;
            if (toets == ConsoleKey.A || toets == ConsoleKey.LeftArrow) return Richting.Links;
            if (toets == ConsoleKey.D || toets == ConsoleKey.RightArrow) return Richting.Rechts;
            return Richting.Geen;
        }
    }
}

#! uitleg
- Het plan is een `string[]`: `plan[y]` is een rij (string), `plan[y][x]` een karakter. Een array van strings gedraagt zich zo als een 2D-raster.
- `IsVrij` is een kleine query die het spel leesbaar maakt. Omdat het plan de rand bevat, kan de speler nooit buiten de array lopen.
- De array `plan` wordt meegegeven aan methods (reference type) maar niet gewijzigd: de speler wordt apart getekend.
- Je ontsnapte uit het doolhof! Level 8 neemt je mee naar de officiële documentatie, kommagetallen en datums.

#! regel type=method doel=IsVrij geeft=bool parameters=3 bericht="Maak een query static bool IsVrij(string[] plan, int x, int y)"
#! regel type=method doel=GetRichting geeft=Richting parameters=1 bericht="Gebruik een method static Richting GetRichting(ConsoleKey toets)"

