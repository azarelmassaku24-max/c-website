#! oefening id=L05-03-m rol=meesterschap moeilijkheid=4 xp=120 titel="Getalfrequentie" bron="D09getalfrequentie"
Schrijf een programma dat de gebruiker om getallen vraagt tussen 0 en 10 (grenzen inclusief) totdat de gebruiker `stop` intypt (hoofdletterongevoelig). Na afloop toont het programma hoe vaak elk van de ingevoerde getallen voorkwam, van klein naar groot.

```text
Geef een getal in [0,10] : 2
Geef een getal in [0,10] : 7
Geef een getal in [0,10] : 7
Geef een getal in [0,10] : 2
Geef een getal in [0,10] : 6
Geef een getal in [0,10] : 7
Geef een getal in [0,10] : StOP
2 kwam 2 keer voor
6 kwam 1 keer voor
7 kwam 3 keer voor
```

Ongeldige invoer of getallen buiten [0,10] worden genegeerd.

#! starter
using System;

namespace D09 {
    class Program {
        static void Main(string[] args) {

        }
    }
}

#! hint
Gebruik een tellerarray `int[] aantalKeer = new int[11];` waarbij het getal zelf de index is.

#! hint
Herhaal tot de invoer (na ToLower) gelijk is aan "stop". Bij een geldig getal in [0,10]: `aantalKeer[getal]++`.

#! hint
Toon na de loop: `for (int getal = 0; getal < aantalKeer.Length; getal++) { if (aantalKeer[getal] > 0) Console.WriteLine(...); }`.

#! oplossing
using System;

namespace D09 {
    class Program {
        static void Main(string[] args) {
            const int maximum = 10;
            int[] aantalKeer = new int[maximum + 1];
            bool stoppen = false;
            while (!stoppen) {
                Console.Write($"Geef een getal in [0,{maximum}] : ");
                string invoer = Console.ReadLine().Trim().ToLower();
                int getal;
                if (invoer == "stop") {
                    stoppen = true;
                } else if (int.TryParse(invoer, out getal) && getal >= 0 && getal <= maximum) {
                    aantalKeer[getal]++;
                }
            }
            for (int getal = 0; getal < aantalKeer.Length; getal++) {
                if (aantalKeer[getal] > 0) {
                    Console.WriteLine($"{getal} kwam {aantalKeer[getal]} keer voor");
                }
            }
        }
    }
}

#! uitleg
- De **waarde als index**: `aantalKeer[getal]++` telt in één stap het juiste vakje op.
- De array heeft 11 elementen (0 t.e.m. 10); defaultwaarde 0 is precies de gewenste beginwaarde van elke teller.
- Bij het tonen worden de getallen vanzelf van klein naar groot overlopen.

#! regel type=statement doel=array bericht="Gebruik een array als tellers"

