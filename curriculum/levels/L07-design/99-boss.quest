#! test naam="IsVrij" soort=code
string[] plan = { "###", "# G", "###" };
Check.Equal(false, Program.IsVrij(plan, 0, 0), "muur");
Check.Equal(true, Program.IsVrij(plan, 1, 1), "vrije plaats");
Check.Equal(true, Program.IsVrij(plan, 2, 1), "uitgang is vrij");
