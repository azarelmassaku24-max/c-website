#! test naam="Ongeldige keuze en invoer" referentie=ja
#! invoer
9
x
4
tien
10
4

#! test naam="Bereken is een correcte query" soort=code
Check.Equal(7.5, Program.Bereken(1, 3, 4.5), "Bereken(1, 3, 4.5)");
Check.Equal(-1.5, Program.Bereken(2, 3, 4.5), "Bereken(2, 3, 4.5)");
Check.Equal(13.5, Program.Bereken(3, 3, 4.5), "Bereken(3, 3, 4.5)");
Check.Equal(2.5, Program.Bereken(4, 10, 4), "Bereken(4, 10, 4)");
string output = Check.Output(() => Program.Bereken(1, 1, 1));
Check.True(output == "", "Bereken toont zelf niets");

#! oefening id=L06-BOSS-2 rol=boss fase="Fase 2" moeilijkheid=5 xp=200 titel="Doorrekenen tot stoppen"
Breid de app uit:

1. Het menu krijgt een optie `0. Stoppen`. `VraagKeuze()` aanvaardt nu 0 t.e.m. 4.
2. Het programma blijft berekeningen doen tot de gebruiker 0 kiest. Het menu wordt telkens opnieuw getoond.
3. Bij delen door 0 toont het programma `Delen door nul kan niet.` in plaats van een resultaat. Maak daarvoor een query `static bool IsGeldig(int keuze, double b)`.
4. Bij het stoppen toont het programma het aantal geslaagde berekeningen: `Tot ziens! Je deed 2 berekening(en).`

```text
=== Rekenmachine ===
1. Optellen
2. Aftrekken
3. Vermenigvuldigen
4. Delen
0. Stoppen
Keuze: 4
Eerste getal: 5
Tweede getal: 0
Delen door nul kan niet.
=== Rekenmachine ===
...
Keuze: 0
Tot ziens! Je deed 0 berekening(en).
```

#! starter
using System;

namespace D10 {
    class Program {
        static void Main(string[] args) {

        }
    }
}

#! hint
Main krijgt een loop rond de bestaande stappen. Welke loop past als het menu minstens één keer getoond moet worden?

#! hint
In de loop: menu tonen, keuze vragen; bij keuze 0 stop je (bv. met een bool `stoppen`), anders getallen vragen en `IsGeldig` controleren. Hou een teller `aantalBerekeningen` bij.

#! hint
`static bool IsGeldig(int keuze, double b) { return !(keuze == 4 && b == 0); }` — een deling door nul is de enige ongeldige combinatie.

#! oplossing
using System;

namespace D10 {
    class Program {
        static void Main(string[] args) {
            int aantalBerekeningen = 0;
            bool stoppen = false;
            while (!stoppen) {
                PrintMenu();
                int keuze = VraagKeuze();
                if (keuze == 0) {
                    stoppen = true;
                } else {
                    double getal1 = VraagGetal("Eerste getal: ");
                    double getal2 = VraagGetal("Tweede getal: ");
                    if (IsGeldig(keuze, getal2)) {
                        Console.WriteLine($"Resultaat: {Bereken(keuze, getal1, getal2)}");
                        aantalBerekeningen++;
                    } else {
                        Console.WriteLine("Delen door nul kan niet.");
                    }
                }
            }
            Console.WriteLine($"Tot ziens! Je deed {aantalBerekeningen} berekening(en).");
        }

        static void PrintMenu() {
            Console.WriteLine("=== Rekenmachine ===");
            Console.WriteLine("1. Optellen");
            Console.WriteLine("2. Aftrekken");
            Console.WriteLine("3. Vermenigvuldigen");
            Console.WriteLine("4. Delen");
            Console.WriteLine("0. Stoppen");
        }

        static int VraagKeuze() {
            int keuze;
            bool ok;
            do {
                Console.Write("Keuze: ");
                ok = int.TryParse(Console.ReadLine(), out keuze) && keuze >= 0 && keuze <= 4;
            } while (!ok);
            return keuze;
        }

        static double VraagGetal(string vraag) {
            double getal;
            bool ok;
            do {
                Console.Write(vraag);
                ok = double.TryParse(Console.ReadLine(), out getal);
            } while (!ok);
            return getal;
        }

        static bool IsGeldig(int keuze, double b) {
            return !(keuze == 4 && b == 0);
        }

        static double Bereken(int keuze, double a, double b) {
            if (keuze == 1) {
                return a + b;
            } else if (keuze == 2) {
                return a - b;
            } else if (keuze == 3) {
                return a * b;
            }
            return a / b;
        }
    }
}

#! uitleg
- Dankzij de methods uit fase 1 hoefde je nauwelijks bestaande code aan te passen: je bouwde er een loop rond. Dat is de winst van goede structuur.
- `IsGeldig` is een kleine query die één beslissing een naam geeft — de if in Main leest daardoor als een zin.
- Proficiat! In Level 7 leer je wat er **echt** gebeurt met parameters (value versus reference types), enums en de console-cursor.

#! regel type=method doel=IsGeldig geeft=bool parameters=2 bericht="Maak een query static bool IsGeldig(int keuze, double b)"
#! regel type=method doel=Bereken geeft=double parameters=3 bericht="Behoud de query Bereken(int keuze, double a, double b)"
#! regel type=loop bericht="Gebruik een loop zodat je kan blijven rekenen"

