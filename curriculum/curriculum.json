{
  // C# Quest — structuur van de opleiding. Gebaseerd op de cursus "Programmeren Basis".
  // Een level = een map met .quest-bestanden (één bestand per les, alfabetisch geordend).
  "title": "C# Quest",
  "levels": [
    { "id": "L01", "number": 1, "title": "C# Fundamentals", "subtitle": "Variabelen, rekenen, beslissingen, invoer en herhalingen", "source": "Deel 03, 04 en 05", "folder": "levels/L01-fundamentals", "color": "#8b6cff", "icon": "code", "requires": [],
      "description": "Je eerste stappen: gegevens bewaren in variabelen, rekenen, beslissingen nemen met if, invoer robuust inlezen en code herhalen met while en do while.",
      "note": "De uitleg over string interpolatie, Math, Random, scope, const, traceertabellen, debugging, if/else, logische bewerkingen, robuuste invoer en herhalingen volgt de uitlegdocumenten van Deel 03–05. De basisuitleg over datatypes, operatoren en typeconversies (Deel 01–02 zitten niet in je materiaal) is aanvullend geschreven en zo gemarkeerd." },
    { "id": "L02", "number": 2, "title": "Loops & Debugging", "subtitle": "for-loops, programma pauzeren, scherm wissen en traceren", "source": "Deel 06", "folder": "levels/L02-loops", "color": "#3fa9ff", "icon": "repeat", "requires": ["L01"],
      "description": "De for-loop, kiezen tussen loops, iteraties traceren, Thread.Sleep en Console.Clear. Met de Twister-generator en de Simon Memory Game." },
    { "id": "L03", "number": 3, "title": "Strings, Characters & Visual Studio", "subtitle": "Projecten, namespaces, char en stringbewerkingen", "source": "Deel 07", "folder": "levels/L03-strings", "color": "#22c3a6", "icon": "type", "requires": ["L02"],
      "description": "Meerdere bestanden en opstartobjecten, namespaces, getallen formatteren, Length en indexen, het char-datatype, strings overlopen, immutable strings, zoeken en Substring." },
    { "id": "L04", "number": 4, "title": "Arrays", "subtitle": "Verzamelingen van waarden bijhouden en overlopen", "source": "Deel 08", "folder": "levels/L04-arrays", "color": "#f59e0b", "icon": "list", "requires": ["L03"],
      "description": "Arrays declareren en initialiseren, defaultwaarden en null, elementen aanspreken, for en foreach, waarden samenstellen, dynamische grootte en zoeken." },
    { "id": "L05", "number": 5, "title": "Advanced Arrays & Strings", "subtitle": "break, parallelle arrays, doorsnedes en Split/Join", "source": "Deel 09", "folder": "levels/L05-advanced", "color": "#ef6aa3", "icon": "layers", "requires": ["L04"],
      "description": "Een loop vroegtijdig beëindigen, parallelle arrays, doorsnedes, frequenties, de lege string en null, Split, Join, Insert, Remove en Replace." },
    { "id": "L06", "number": 6, "title": "Methods & Program Structure", "subtitle": "Code opdelen in herbruikbare methods", "source": "Deel 10", "folder": "levels/L06-methods", "color": "#6d8bff", "icon": "puzzle", "requires": ["L05"],
      "description": "Methods definiëren en oproepen, parameters, return values, lokale variabelen, command versus query, het DRY-principe en de call stack in de debugger." },
    { "id": "L07", "number": 7, "title": "Software Design & Parameters", "subtitle": "Value en reference types, enums en de console", "source": "Deel 11", "folder": "levels/L07-design", "color": "#14b8a6", "icon": "box", "requires": ["L06"],
      "description": "Softwareontwerp, parameters van value en reference types doorgeven, return values, enumeraties, de cursor positioneren en één toets inlezen." },
    { "id": "L08", "number": 8, "title": "Data Types, DateTime & Documentation", "subtitle": "Documentatie lezen, afronden, datums en tijdsduren", "source": "Deel 12", "folder": "levels/L08-datatypes", "color": "#f97316", "icon": "calendar", "requires": ["L07"],
      "description": "De officiële .NET-documentatie, numerieke datatypes en afrondingsfouten, Math.Round met MidpointRounding, DateTime, TimeSpan, dot-notatie, namespaces en using." },
    { "id": "L09", "number": 9, "title": "File Handling & Exceptions", "subtitle": "Gegevens bewaren in bestanden en fouten opvangen", "source": "Deel 13", "folder": "levels/L09-files", "color": "#a855f7", "icon": "database", "requires": ["L08"],
      "description": "Tekstbestanden lezen en schrijven, relatieve en absolute paden, Path.Combine, exception handling met try/catch/finally, StreamReader, StreamWriter en using." },
    { "id": "L10", "number": 10, "title": "Object-Oriented Programming", "subtitle": "Klassen, objecten, toestand en gedrag", "source": "Deel 14", "folder": "levels/L10-oop", "color": "#0ea5e9", "icon": "box", "requires": ["L09"],
      "description": "Objecten bundelen toestand en gedrag. Klassen, datavelden, methods, public en private, new, reference types en null, instance versus static, objectdiagrammen en NullReferenceException." },
    { "id": "L11", "number": 11, "title": "Properties, Constructors & Composition", "subtitle": "Objecten correct en veilig opbouwen", "source": "Deel 15 (oefeningen) + verdieping", "folder": "levels/L11-properties", "color": "#10b981", "icon": "shield", "requires": ["L10"],
      "description": "Properties met get en set, readonly en auto-implemented properties, constructors en constructor chaining, immutable objecten en objecten die andere objecten bevatten.",
      "note": "Voor Deel 15 zat geen afzonderlijk uitlegdocument in je materiaal (het bestand 'uitleg 15' is dezelfde tekst als Deel 14). De uitleg is opgebouwd vanuit de oefeningen en oplossingen van Deel 15 en het verdiepingsdocument, en aanvullend geschreven waar nodig." },
    { "id": "L12", "number": 12, "title": "Collections", "subtitle": "List, LinkedList en HashSet", "source": "Deel 16", "folder": "levels/L12-collections", "color": "#eab308", "icon": "layers", "requires": ["L11"],
      "description": "Collecties die vanzelf groeien en krimpen: List<T>, LinkedList<T> en HashSet<T>, hun methods, elementen verwijderen tijdens het overlopen en de keuze van de juiste collectie." },
    { "id": "L13", "number": 13, "title": "Dictionaries", "subtitle": "Waarden opzoeken via een key", "source": "Deel 17", "folder": "levels/L13-dictionaries", "color": "#f43f5e", "icon": "search", "requires": ["L12"],
      "description": "Dictionary<TKey, TValue>: key/value-relaties, opzoeken, toevoegen en verwijderen, Keys en Values, frequenties tellen en dictionaries met eigen klassen." },
    { "id": "L14", "number": 14, "title": "Interfaces & Professional Software Design", "subtitle": "Flexibele architecturen en eigen sorteerlogica", "source": "Deel 18 + 3 demoprojecten", "folder": "levels/L14-interfaces", "color": "#8b5cf6", "icon": "shield", "requires": ["L13"],
      "description": "Waarom interfaces nodig zijn, interfaces implementeren, static type checking, UML, high cohesion en low coupling, IComparer<T> en comparer-klassen. Met de case study Circle/Rectangle → Figure → IFigure." },
    { "id": "PA", "number": 15, "kind": "project", "title": "Project: Personenapplicatie", "subtitle": "Eén applicatie die meegroeit met je kennis (PA2 → PA5)", "source": "Deel PA2, PA3, PA4 en PA5", "folder": "levels/PA-personen", "color": "#22c55e", "icon": "users", "requires": ["L06"],
      "description": "Een doorlopend project: de personenapplicatie wordt stap voor stap verbeterd zonder dat de functionaliteit verandert. Methods (PA2), bestanden (PA3), een Persoon-klasse (PA4) en collecties (PA5). Elke fase wordt ontgrendeld zodra je het bijhorende level beheerst." },
    { "id": "VD", "number": 16, "kind": "verdieping", "title": "Verdieping", "subtitle": "Extra leerstof bij Deel 10, 13 en 15", "source": "Verdiepingsdocumenten 10, 13 en 15", "folder": "levels/VD-verdieping", "color": "#38bdf8", "icon": "sparkles", "requires": ["L06"],
      "description": "Optioneel: method overloading, optionele parameters en named arguments, methods genereren, var, IDisposable en streams afsluiten, try/finally, zelf geïmplementeerde en readonly berekende properties, garbage collection. Verstoort je leertraject niet." }
  ],
  "skills": [
    { "id": "variabelen", "title": "Variabelen & datatypes", "level": "L01", "requires": [], "x": 0, "y": 1, "description": "int, double, string en bool; declareren, initialiseren en toekennen." },
    { "id": "invoer", "title": "Invoer & Parse", "level": "L01", "requires": ["variabelen"], "x": 1, "y": 0, "description": "Console.ReadLine en tekst omzetten naar getallen." },
    { "id": "operatoren", "title": "Rekenen & Math", "level": "L01", "requires": ["variabelen"], "x": 1, "y": 1, "description": "Rekenkundige operatoren, gehele deling, modulo, verkorte notatie en Math." },
    { "id": "interpolatie", "title": "String interpolatie", "level": "L01", "requires": ["variabelen"], "x": 1, "y": 2, "description": "Strings bouwen met $\"...{variabele}...\"." },
    { "id": "scope", "title": "Scope & const", "level": "L01", "requires": ["variabelen"], "x": 1, "y": 3, "description": "Waar een variabele bestaat, naamgeving en magic values." },
    { "id": "if-else", "title": "if / else if / else", "level": "L01", "requires": ["operatoren"], "x": 2, "y": 1, "description": "Beslissingen nemen met vergelijkingsoperatoren." },
    { "id": "logisch", "title": "Logische operatoren", "level": "L01", "requires": ["if-else"], "x": 3, "y": 0, "description": "&&, || en ! en interval checking." },
    { "id": "random", "title": "Random getallen", "level": "L01", "requires": ["if-else"], "x": 3, "y": 2, "description": "Willekeurige getallen met Random.Next." },
    { "id": "robuust", "title": "Robuuste invoer", "level": "L01", "requires": ["invoer", "if-else"], "x": 3, "y": 1, "description": "ToLower, Trim en TryParse." },
    { "id": "while", "title": "while & do while", "level": "L01", "requires": ["if-else"], "x": 4, "y": 1, "description": "Herhalingen met een voorwaarde." },
    { "id": "accumuleren", "title": "Som, gemiddelde, max", "level": "L01", "requires": ["while"], "x": 5, "y": 0, "description": "Waarden bijhouden over herhalingen heen." },
    { "id": "traceren", "title": "Traceren & debuggen", "level": "L01", "requires": ["operatoren"], "x": 2, "y": 3, "description": "Traceertabellen, breakpoints en het Locals-venster." },
    { "id": "for", "title": "for-loop", "level": "L02", "requires": ["while"], "x": 5, "y": 1, "description": "Herhalen met een teller." },
    { "id": "geneste-loops", "title": "Geneste loops", "level": "L02", "requires": ["for"], "x": 6, "y": 1, "description": "Een loop in een loop (rijen en kolommen)." },
    { "id": "pauzeren", "title": "Sleep & Clear", "level": "L02", "requires": ["while"], "x": 5, "y": 2, "description": "Thread.Sleep en Console.Clear." },
    { "id": "projecten", "title": "Projecten & namespaces", "level": "L03", "requires": ["traceren"], "x": 6, "y": 3, "description": "Meerdere bestanden, opstartobjecten en namespaces." },
    { "id": "strings", "title": "Stringbewerkingen", "level": "L03", "requires": ["for"], "x": 6, "y": 0, "description": "Length, indexen, char, ToUpper, foreach over strings." },
    { "id": "zoeken-strings", "title": "Zoeken in strings", "level": "L03", "requires": ["strings"], "x": 7, "y": 0, "description": "IndexOf, Contains, StartsWith en Substring." },
    { "id": "arrays", "title": "Arrays", "level": "L04", "requires": ["geneste-loops"], "x": 7, "y": 1, "description": "Arrays declareren, initialiseren en elementen aanspreken." },
    { "id": "array-loops", "title": "Arrays overlopen", "level": "L04", "requires": ["arrays"], "x": 8, "y": 1, "description": "for en foreach, waarden samenstellen en omkeren." },
    { "id": "array-zoeken", "title": "Zoeken in arrays", "level": "L04", "requires": ["array-loops"], "x": 8, "y": 2, "description": "Posities zoeken en dynamische groottes." },
    { "id": "break", "title": "break", "level": "L05", "requires": ["array-zoeken"], "x": 9, "y": 2, "description": "Een loop vroegtijdig beëindigen." },
    { "id": "parallelle-arrays", "title": "Parallelle arrays", "level": "L05", "requires": ["array-loops"], "x": 9, "y": 1, "description": "Gegevens over meerdere arrays met dezelfde index." },
    { "id": "split-join", "title": "Split, Join & co", "level": "L05", "requires": ["zoeken-strings", "arrays"], "x": 9, "y": 0, "description": "Split, Join, Insert, Remove en Replace." },
    { "id": "methods", "title": "Methods", "level": "L06", "requires": ["parallelle-arrays"], "x": 10, "y": 1, "description": "Code structureren in methods." },
    { "id": "parameters", "title": "Parameters & return", "level": "L06", "requires": ["methods"], "x": 11, "y": 1, "description": "Gegevens doorgeven en teruggeven; command versus query." },
    { "id": "call-stack", "title": "Call stack", "level": "L06", "requires": ["parameters"], "x": 11, "y": 2, "description": "Methodactivaties en Step Into/Over/Out." },
    { "id": "value-reference", "title": "Value & reference types", "level": "L07", "requires": ["parameters"], "x": 12, "y": 1, "description": "Wat er gebeurt met parameters van value en reference types." },
    { "id": "enums", "title": "Enums", "level": "L07", "requires": ["methods"], "x": 12, "y": 2, "description": "Eigen opsommingstypes." },
    { "id": "console-ui", "title": "Cursor & ReadKey", "level": "L07", "requires": ["methods"], "x": 12, "y": 3, "description": "Console.SetCursorPosition en Console.ReadKey." },
    { "id": "afronden", "title": "Numerieke types & afronden", "level": "L08", "requires": ["value-reference"], "x": 13, "y": 0, "description": "float, double, decimal, Math.Round en MidpointRounding." },
    { "id": "datetime", "title": "DateTime & TimeSpan", "level": "L08", "requires": ["afronden"], "x": 14, "y": 0, "description": "Momenten en tijdsduren." },
    { "id": "documentatie", "title": "Documentatie & using", "level": "L08", "requires": ["projecten"], "x": 13, "y": 3, "description": "API-documentatie lezen, namespaces en using." },
    { "id": "bestanden", "title": "Bestanden", "level": "L09", "requires": ["afronden"], "x": 14, "y": 1, "description": "File.ReadAllText, WriteAllLines, AppendAllText en paden." },
    { "id": "exceptions", "title": "Exception handling", "level": "L09", "requires": ["bestanden"], "x": 15, "y": 1, "description": "try, catch en finally." },
    { "id": "streams", "title": "StreamReader & Writer", "level": "L09", "requires": ["exceptions"], "x": 16, "y": 0, "description": "Streams en using-statements." },
    { "id": "klassen", "title": "Klassen & objecten", "level": "L10", "requires": ["value-reference"], "x": 13, "y": 2, "description": "Datavelden, methods, new en objectdiagrammen." },
    { "id": "static", "title": "Instance vs static", "level": "L10", "requires": ["klassen"], "x": 14, "y": 3, "description": "Object gerelateerde en klasse gerelateerde methods." },
    { "id": "null", "title": "null & NullReference", "level": "L10", "requires": ["klassen"], "x": 14, "y": 2, "description": "Reference types zonder object." },
    { "id": "properties", "title": "Properties", "level": "L11", "requires": ["klassen"], "x": 15, "y": 2, "description": "get, set, readonly en auto-implemented." },
    { "id": "constructors", "title": "Constructors", "level": "L11", "requires": ["properties"], "x": 16, "y": 2, "description": "Verplichte initialisatie en constructor chaining." },
    { "id": "compositie", "title": "Compositie", "level": "L11", "requires": ["constructors"], "x": 17, "y": 2, "description": "Objecten die andere objecten bevatten." },
    { "id": "list", "title": "List<T>", "level": "L12", "requires": ["properties"], "x": 16, "y": 3, "description": "Een array die vanzelf groeit." },
    { "id": "collecties", "title": "LinkedList & HashSet", "level": "L12", "requires": ["list"], "x": 17, "y": 3, "description": "Andere collecties en wanneer je welke kiest." },
    { "id": "dictionary", "title": "Dictionary", "level": "L13", "requires": ["list"], "x": 17, "y": 4, "description": "Key/value-paren opzoeken." },
    { "id": "interfaces", "title": "Interfaces", "level": "L14", "requires": ["compositie", "collecties"], "x": 18, "y": 2, "description": "Contracten voor verschillende klassen." },
    { "id": "comparer", "title": "IComparer<T>", "level": "L14", "requires": ["interfaces"], "x": 19, "y": 2, "description": "Eigen sorteerlogica." },
    { "id": "ontwerp", "title": "High cohesion & low coupling", "level": "L14", "requires": ["interfaces"], "x": 19, "y": 3, "description": "Goede en slechte softwarestructuren herkennen." },
    { "id": "overloading", "title": "Overloading & optionele parameters", "level": "VD", "requires": ["parameters"], "x": 12, "y": 4, "description": "Verdieping bij Deel 10." },
    { "id": "idisposable", "title": "IDisposable & try/finally", "level": "VD", "requires": ["streams"], "x": 17, "y": 0, "description": "Verdieping bij Deel 13." },
    { "id": "eigen-properties", "title": "Eigen properties & GC", "level": "VD", "requires": ["properties"], "x": 16, "y": 4, "description": "Verdieping bij Deel 15." }
